# Port backend Node.js utilise par Express et Socket.IO.
# Obligatoire en production. Exemple: 3020
PORT=3020

# Adresse d'ecoute du backend.
# 0.0.0.0 ecoute toutes les interfaces. Derriere Nginx, 127.0.0.1 est souvent preferable.
HOST=0.0.0.0

# Mode d'execution Node.js.
# Valeurs courantes: development | production
NODE_ENV=development

# URL publique de l'application, utilisee comme origine par defaut.
# Exemple: https://infiltre-dev.traillearn.org
PUBLIC_URL=https://infiltre-dev.traillearn.org

# Domaine autorise pour CORS.
# Doit correspondre a l'URL depuis laquelle le navigateur charge le frontend.
CORS_ORIGIN=https://infiltre-dev.traillearn.org

# URL frontend utilisee en developpement si CORS_ORIGIN n'est pas renseigne.
# Exemple local: http://localhost:5173
CLIENT_URL=https://infiltre-dev.traillearn.org

# Identifiant de l'interface administrateur.
# A modifier avant tout deploiement public.
ADMIN_USERNAME=aubinaso

# Mot de passe de l'interface administrateur.
# Ne jamais utiliser cette valeur par defaut en production.
ADMIN_PASSWORD=change-me

# ===========================================================================
# IA des bots — Azure OpenAI (UN SEUL deploiement de modele de chat)
# ---------------------------------------------------------------------------
# Deploie un modele de CHAT (gpt-4o-mini recommande, ou gpt-4o) dans Azure OpenAI
# Studio, puis renseigne ces 4 variables. N'utilise PAS un modele o-series (o1/o3) :
# le service envoie temperature + max_tokens, qu'ils n'acceptent pas.
# Si elles sont vides, les bots tournent quand meme avec leurs personnalites
# hors-ligne (botPersonas) ; l'IA les rend simplement plus contextuels.

# URL de la ressource Azure OpenAI, ex. https://ma-ressource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# Cle API Azure OpenAI, cote serveur uniquement (jamais exposee au frontend / Git / logs).
AZURE_OPENAI_API_KEY=

# Nom EXACT du deploiement de chat cree dans Azure (ex. infiltres-bots).
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Version d'API (celle affichee par ton deploiement dans Azure Studio).
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Active les bots IA.
# true = les controles d'ajout de bots sont disponibles si Azure est configure.
BOT_AI_ENABLED=true

# Nombre maximum de bots IA par salon. Le total humains + bots reste limite par maxPlayers.
BOT_MAX_PER_ROOM=20

# Nombre de bots ajoute par defaut dans un salon quand les bots sont actives.
BOT_DEFAULT_COUNT=1

# Complete automatiquement le lobby avec des bots pour atteindre le minimum de joueurs.
BOT_AUTO_FILL_ENABLED=false

# Niveau de participation par defaut des bots.
# Valeurs: discreet | normal | talkative
BOT_DEFAULT_PARTICIPATION=normal

# Temps moyen de reponse des bots en millisecondes.
BOT_AVERAGE_RESPONSE_MS=1500

# Autorise les bots a devenir Maire.
BOT_ALLOW_MAYOR=true

# Autorise les bots a parler pendant les debats.
BOT_ALLOW_DEBATE_SPEECH=true

# Active les voix audio IA des bots.
# false = MVP texte uniquement. Les bots continuent de jouer, parler, voter et agir la nuit.
BOT_AUDIO_ENABLED=false

# Autorise les bots a utiliser l'audio integre quand la voix IA sera active.
BOT_ALLOW_AUDIO=false

# Budget maximum de tokens de sortie du modele de chat.
BOT_MAX_OUTPUT_TOKENS=1200

# Style de reponse des bots: simple | advanced.
BOT_RESPONSE_STYLE=advanced

# Active les variations de personnalite par bot.
BOT_PERSONALITY_VARIATION=true

# Active une voix stable et differente par bot.
BOT_VOICE_VARIATION_ENABLED=true

# Voix par defaut si la variation est desactivee ou indisponible.
BOT_DEFAULT_VOICE=alloy

# Liste des voix realtime utilisables par le deployment configure.
BOT_AVAILABLE_VOICES=alloy,ash,ballad,coral,echo,onyx,nova,sage,shimmer,verse

# Autorise les prises de parole contextuelles non limitees aux mentions directes.
BOT_AUTO_SPEAK_ENABLED=true

# Cooldown minimal entre deux prises de parole par bot.
BOT_SPEAK_COOLDOWN_SECONDS=20

# Nombre maximum de messages par bot et par minute.
BOT_MAX_MESSAGES_PER_MINUTE=2

# Timeout d'un appel realtime Azure pour une decision de bot, en millisecondes.
# Optionnel. Garder une valeur courte evite de bloquer une phase de jeu.
BOT_AI_TIMEOUT_MS=12000

# ===========================================================================
# Voix du narrateur (optionnelle, synthese cote serveur via Azure)
# ---------------------------------------------------------------------------
# Desactivee par defaut : si NARRATOR_TTS_ENABLED!=true ou si les identifiants
# du fournisseur choisi sont absents, le client utilise la voix du navigateur.
NARRATOR_TTS_ENABLED=false

# Fournisseur : "azure-speech" (voix neuronales narration, recommande) ou
# "azure-openai" (reutilise l'endpoint/cle Azure OpenAI ci-dessus).
NARRATOR_TTS_PROVIDER=azure-speech

# Voix utilisee. azure-speech : ex. fr-FR-HenriNeural, fr-FR-ClaudeNeural,
# fr-FR-DeniseNeural. azure-openai : ex. onyx, echo, sage.
NARRATOR_TTS_VOICE=fr-FR-HenriNeural

# Style optionnel (azure-speech uniquement), ex. narration-relaxed. Laisser vide sinon.
NARRATOR_TTS_STYLE=

# Timeout de synthese en millisecondes.
NARRATOR_TTS_TIMEOUT_MS=8000

# --- Fournisseur azure-speech (Azure Cognitive Services Speech) ---
# Cle et region d'une ressource Speech (ex. region : francecentral).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Fournisseur azure-openai (Azure OpenAI /audio/speech) ---
# Par defaut, reutilise AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_REALTIME_ENDPOINT
# et la cle correspondante. Renseigner un deploiement TTS (ex. gpt-4o-mini-tts, tts-1).
AZURE_OPENAI_TTS_ENDPOINT=
AZURE_OPENAI_TTS_API_KEY=
AZURE_OPENAI_TTS_DEPLOYMENT=
AZURE_OPENAI_TTS_API_VERSION=2024-08-01-preview
