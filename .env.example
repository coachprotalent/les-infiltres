# Port backend Node.js utilise par Express et Socket.IO.
# Obligatoire en production. Exemple: 3020
PORT=3020

# Adresse d'ecoute du backend.
# 0.0.0.0 ecoute toutes les interfaces. Derriere Nginx, 127.0.0.1 est souvent preferable.
HOST=0.0.0.0

# Mode d'execution Node.js.
# Valeurs courantes: development | production
NODE_ENV=development

# URL publique de l'application, utilisee comme origine par defaut.
# Exemple: https://infiltre-dev.traillearn.org
PUBLIC_URL=https://infiltre-dev.traillearn.org

# Domaine autorise pour CORS.
# Doit correspondre a l'URL depuis laquelle le navigateur charge le frontend.
CORS_ORIGIN=https://infiltre-dev.traillearn.org

# URL frontend utilisee en developpement si CORS_ORIGIN n'est pas renseigne.
# Exemple local: http://localhost:5173
CLIENT_URL=https://infiltre-dev.traillearn.org

# Identifiant de l'interface administrateur.
# A modifier avant tout deploiement public.
ADMIN_USERNAME=aubinaso

# Mot de passe de l'interface administrateur.
# Ne jamais utiliser cette valeur par defaut en production.
ADMIN_PASSWORD=change-me

# Endpoint Azure OpenAI de la ressource qui contient le deploiement realtime.
# Exemple Azure OpenAI: https://my-resource.openai.azure.com/
# Exemple Cognitive Services: https://my-resource.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=

# Cle API Azure OpenAI cote serveur uniquement.
# Ne jamais exposer cette valeur au frontend, dans Git, dans des logs ou dans une capture.
AZURE_OPENAI_API_KEY=

# Version API Azure OpenAI utilisee pour l'endpoint realtime preview.
# Pour un endpoint GA /openai/v1/realtime, le service sait aussi essayer le format sans api-version.
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Nom exact du deploiement realtime Azure OpenAI utilise par les bots.
# C'est la variable principale des bots IA. Ne pas utiliser AZURE_OPENAI_DEPLOYMENT pour eux.
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-1.5

# Active les bots IA.
# true = les controles d'ajout de bots sont disponibles si Azure est configure.
BOT_AI_ENABLED=true

# Nombre maximum de bots IA par salon.
BOT_MAX_PER_ROOM=6

# Niveau de participation par defaut des bots.
# Valeurs: discreet | normal | talkative
BOT_DEFAULT_PARTICIPATION=normal

# Active les voix audio IA des bots.
# false = MVP texte uniquement. Les bots continuent de jouer, parler, voter et agir la nuit.
BOT_AUDIO_ENABLED=false

# Timeout d'un appel realtime Azure pour une decision de bot, en millisecondes.
# Optionnel. Garder une valeur courte evite de bloquer une phase de jeu.
BOT_AI_TIMEOUT_MS=12000
